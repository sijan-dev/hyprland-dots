  "tokenColors": [
    { "name": "Comment", "scope": "comment", "settings": { "foreground": "{{ colors.on_surface_variant.default.hex }}", "fontStyle": "italic" } },
    { "name": "Strings", "scope": ["constant.numeric", "string", "string.quoted", "string.template"], "settings": { "foreground": "{{ colors.secondary.default.hex }}" } },
    { "name": "Keywords", "scope": ["keyword", "storage.type", "storage.modifier"], "settings": { "foreground": "{{ colors.primary.default.hex }}" } },
    { "name": "Functions & Types", "scope": ["entity.name.function", "entity.name.type", "entity.name.class", "entity.other.attribute-name"], "settings": { "foreground": "{{ colors.primary_container.default.hex }}" } },
    { "name": "Variables", "scope": ["variable", "variable.language", "variable.parameter"], "settings": { "foreground": "{{ colors.on_background.default.hex }}" } },
    { "name": "Invalid", "scope": "invalid", "settings": { "foreground": "{{ colors.error.default.hex }}" } },
    { "name": "Constants", "scope": ["constant.language", "constant.character"], "settings": { "foreground": "{{ colors.tertiary.default.hex }}" } },
    { "name": "Support", "scope": ["support.type", "support.class", "support.function"], "settings": { "foreground": "{{ colors.tertiary.default.hex }}" } },
    { "name": "Punctuation", "scope": ["punctuation", "meta.delimiter"], "settings": { "foreground": "{{ colors.on_background.default.hex }}" } },
    { "name": "Tags", "scope": "entity.name.tag", "settings": { "foreground": "{{ colors.error.default.hex }}" } },
    { "name": "Markdown Headings", "scope": "markup.heading", "settings": { "foreground": "{{ colors.primary.default.hex }}", "fontStyle": "bold" } },
    { "name": "Markdown Bold", "scope": "markup.bold", "settings": { "fontStyle": "bold", "foreground": "{{ colors.on_background.default.hex }}" } },
    { "name": "Markdown Italic", "scope": "markup.italic", "settings": { "fontStyle": "italic", "foreground": "{{ colors.on_background.default.hex }}" } }
  ]
}
